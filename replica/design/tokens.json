{
  "_about": "Design tokens for Anvar Abduqayum B2B Industrial Platform (The Authority Experience). Governs Dark Obsidian & Light Cream palettes, gold/amber accents, type scale, spacing, radius, and WCAG 2.2 accessibility pairs.",
  "color": {
    "bg-dark": "#090A0D",
    "surface-dark": "#12141A",
    "surface-elevated": "#17181D",
    "surface-card": "#181B24",
    "border-dark": "#272A34",
    "border-dark-subtle": "rgba(255, 255, 255, 0.08)",
    "border-input": "#586173",
    "text-dark": "#F5F4F0",
    "text-muted-dark": "#8E95A5",
    "text-dim": "#666D7D",
    
    "bg-light": "#F6F3EC",
    "surface-light": "#FFFFFF",
    "surface-light-subtle": "#EFEBE1",
    "border-light": "#DCD7CC",
    "border-light-input": "#7A8291",
    "text-light": "#14161A",
    "text-muted-light": "#585F6E",

    "accent-gold": "#D4AF37",
    "on-accent-gold": "#090A0D",
    "accent-gold-hover": "#E5BE42",
    "accent-amber": "#D97736",
    "accent-cobalt": "#2563EB",
    "on-accent-cobalt": "#FFFFFF",

    "danger": "#E05252",
    "success": "#2E9E66",
    "warning": "#EAB308"
  },
  "pairs": [
    ["text-dark", "bg-dark"],
    ["text-dark", "surface-dark"],
    ["text-dark", "surface-elevated"],
    ["text-dark", "surface-card"],
    ["text-muted-dark", "bg-dark"],
    ["text-muted-dark", "surface-dark"],
    ["text-muted-dark", "surface-elevated"],
    ["text-dim", "bg-dark", "large"],
    ["accent-gold", "bg-dark"],
    ["accent-gold", "surface-dark"],
    ["accent-gold", "surface-elevated"],
    ["on-accent-gold", "accent-gold"],
    ["text-light", "bg-light"],
    ["text-light", "surface-light"],
    ["text-muted-light", "bg-light"],
    ["text-muted-light", "surface-light"],
    ["on-accent-cobalt", "accent-cobalt"],
    ["danger", "bg-dark", "large"],
    ["success", "bg-dark", "large"],
    ["border-input", "bg-dark", "ui"],
    ["border-light-input", "bg-light", "ui"]
  ],
  "font": {
    "sans": "var(--font-sans), 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
    "serif": "var(--font-display), 'Playfair Display', Georgia, serif",
    "mono": "var(--font-mono), 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
  },
  "type": {
    "2xs": { "size": 10, "line": 14, "weight": 600, "letterSpacing": "0.12em" },
    "xs": { "size": 12, "line": 16, "weight": 500, "letterSpacing": "0.06em" },
    "sm": { "size": 13, "line": 19, "weight": 400, "letterSpacing": "0" },
    "base": { "size": 15, "line": 23, "weight": 400, "letterSpacing": "0" },
    "md": { "size": 17, "line": 25, "weight": 500, "letterSpacing": "-0.01em" },
    "lg": { "size": 21, "line": 28, "weight": 600, "letterSpacing": "-0.02em" },
    "xl": { "size": 28, "line": 34, "weight": 700, "letterSpacing": "-0.03em" },
    "2xl": { "size": 38, "line": 44, "weight": 700, "letterSpacing": "-0.035em" },
    "display": { "size": 52, "line": 58, "weight": 700, "letterSpacing": "-0.04em" }
  },
  "space": [0, 2, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128],
  "radius": {
    "none": 0,
    "xs": 2,
    "sm": 4,
    "md": 6,
    "lg": 8,
    "full": 999
  },
  "shadow": {
    "subtle": "0 2px 8px rgba(0, 0, 0, 0.25)",
    "elevated": "0 12px 36px rgba(0, 0, 0, 0.45)",
    "glass": "0 24px 64px rgba(0, 0, 0, 0.65)",
    "gold-glow": "0 0 20px rgba(212, 175, 55, 0.22)"
  },
  "motion": {
    "fast": "120ms cubic-bezier(0.2, 0.8, 0.2, 1)",
    "base": "200ms cubic-bezier(0.2, 0.8, 0.2, 1)",
    "slow": "400ms cubic-bezier(0.16, 1, 0.3, 1)",
    "monograph": "600ms cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
