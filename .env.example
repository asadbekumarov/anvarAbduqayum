# Telegram Bot API Configuration (for consultation leads)
# Obtain bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Target Chat / Channel / Group ID (e.g. -1001234567890 or your numeric user ID)
TELEGRAM_CHAT_ID=-1001234567890

# Public Production Site URL (metadataBase, canonical, og:image, sitemap va robots uchun)
# Production domen: https://ilhom-begimqulov.vercel.app
NEXT_PUBLIC_SITE_URL=https://ilhom-begimqulov.vercel.app

# Cal.com Public Booking Event Link / Slug (masalan: "ilhom/diagnostika" yoki "ilhom-begimqulov/20min")
# Cal.com dashboardidan olingan ommaviy havola (kodda qattiq yozilmaydi)
NEXT_PUBLIC_CAL_LINK=ilhom/diagnostika

# Cal.com Webhook Secret
# Cal.com sozlamalari (Settings -> Developer -> Webhooks) da ko'rsatilgan maxfiy kalit.
# HMAC SHA-256 (x-cal-signature-256) so'rov imzosini tekshirish uchun ishlatiladi.
CAL_WEBHOOK_SECRET=your_cal_webhook_secret_here

